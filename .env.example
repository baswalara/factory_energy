# Copy to .env. Never commit .env.
MOCK_LLM=true                 # true = no model needed: rule-based question labels and template brief
LLM_PROVIDER=ollama           # ollama | openai | anthropic | gemini
LLM_MODEL=                    # empty = default for the provider (llama3.1:8b, gpt-6-luna, claude-haiku-4-5-20251001, gemini-3.8-flash)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
# Optional overrides of config.yaml
# EMISSION_FACTOR_KG_PER_KWH=0.4
# FACTORY_TIMEZONE=Asia/Kolkata   # only for data with true UTC timestamps; leave unset for data/history (naive = local)
